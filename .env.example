# Copy to .env and fill in real values. Never commit the real .env file.

# Required before exposing /scan or /scan-file on a public/deployed endpoint.
# Without this set, the API runs UNAUTHENTICATED (fine for local dev only).
# Generate one with: openssl rand -hex 32
SHADOW_AI_API_KEY=

# Comma-separated IPs of reverse proxies / load balancers you deploy behind.
# X-Forwarded-For is only honoured when the direct TCP peer is in this list.
# Leave empty if the service is reached directly (no proxy in front of it).
TRUSTED_PROXIES=
